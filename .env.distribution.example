# Distribution automation secrets — copy to .env.distribution (git-ignored).
# Never commit .env.distribution.

# dev.to (Settings → Extensions → DEV Community API Keys → New key)
DEVTO_API_KEY=

# LinkedIn app credentials (linkedin.com/developers/apps → Auth tab)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Populated by scripts/linkedin-oauth.mjs after one-time OAuth handshake.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_MEMBER_URN=

# Refresh token issue date (ISO-8601). Cliff = +365 days from this.
LINKEDIN_REFRESH_TOKEN_ISSUED_AT=

# Optional: fine-grained PAT with contents:write, used by cron when
# GITHUB_TOKEN is not present (e.g. local invocation of publish-due.mjs).
GH_PUSH_TOKEN=
