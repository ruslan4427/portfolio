# Resend — contact form email delivery.
# Get a key at https://resend.com/api-keys. Without this key set,
# submissions log to the server console and the form still returns success
# (so the UI can ship before DNS + domain verification are ready).
RESEND_API_KEY=

# Where contact form submissions are delivered.
CONTACT_TO_EMAIL=rusgrekovua@gmail.com

# Verified sender. Must be on a domain you've verified in Resend
# (TXT + DKIM records). Falls back to onboarding@resend.dev in dev.
CONTACT_FROM_EMAIL="Ruslan Portfolio <onboarding@resend.dev>"

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to
# disable analytics entirely — GA4 script won't load, no cookies set.
# EU visitors see a consent banner and analytics stay off until they
# accept. Non-EU visitors get analytics by default (banner suppressed).
NEXT_PUBLIC_GA_ID=

# Google Search Console verification token (the value of the
# `content` attribute from the "HTML tag" method). Leave empty to
# skip the meta tag.
NEXT_PUBLIC_GSC_VERIFICATION=
